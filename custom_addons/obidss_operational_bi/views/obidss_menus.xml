<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Top Level Application Menu: OBIDSS (Hidden from users/reviewers as per requirements) -->
        <menuitem id="menu_obidss_root"
                  name="OBIDSS"
                  web_icon="obidss_operational_bi,static/description/icon.png"
                  groups="group_obidss_admin"
                  sequence="5"/>

        <!-- 1. Executive Operations -->
        <menuitem id="menu_obidss_executive"
                  name="Executive Operations"
                  parent="menu_obidss_root"
                  action="spreadsheet_dashboard.spreadsheet_dashboard_action"
                  groups="group_obidss_admin"
                  sequence="10"/>

        <!-- 2. Sales Operations -->
        <menuitem id="menu_obidss_sales"
                  name="Sales Operations"
                  parent="menu_obidss_root"
                  action="sale.action_orders"
                  groups="group_obidss_admin"
                  sequence="20"/>

        <!-- 3. Purchase & Suppliers -->
        <menuitem id="menu_obidss_purchase"
                  name="Purchase &amp; Suppliers"
                  parent="menu_obidss_root"
