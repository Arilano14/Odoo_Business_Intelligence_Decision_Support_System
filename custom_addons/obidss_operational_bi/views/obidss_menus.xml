                  groups="group_obidss_admin"
                  sequence="60"/>

        <!-- 7. Configuration -->
        <menuitem id="menu_obidss_config"
                  name="Configuration"
                  parent="menu_obidss_root"
                  action="spreadsheet_dashboard.spreadsheet_dashboard_dashboard_action"
                  groups="group_obidss_admin"
                  sequence="70"/>
